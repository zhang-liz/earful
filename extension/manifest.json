{
  "manifest_version": 3,
  "name": "Earful",
  "version": "1.0.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "remote-audio.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "read-or-pause": {
      "suggested_key": {
        "default": "Alt+R",
        "mac": "Alt+R"
      },
      "description": "__MSG_cmdRead__"
    },
    "skip-back": {
      "suggested_key": {
        "default": "Alt+Comma",
        "mac": "Alt+Comma"
      },
      "description": "__MSG_cmdBack__"
    },
    "skip-forward": {
      "suggested_key": {
        "default": "Alt+Period",
        "mac": "Alt+Period"
      },
      "description": "__MSG_cmdForward__"
    }
  },
  "optional_host_permissions": [
    "http://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
