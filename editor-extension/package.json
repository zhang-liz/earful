{
  "name": "read-it-to-me",
  "displayName": "Earful",
  "description": "Read the text in your editor aloud in a natural voice, highlighting each word.",
  "version": "1.0.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "readItToMe.readSelection",
        "title": "Read Selection",
        "category": "Earful",
        "icon": "$(play)"
      },
      {
        "command": "readItToMe.readFile",
        "title": "Read Whole File",
        "category": "Earful",
        "icon": "$(play)"
      },
      {
        "command": "readItToMe.toggle",
        "title": "Play or Pause",
        "category": "Earful",
        "icon": "$(debug-pause)"
      },
      {
        "command": "readItToMe.stop",
        "title": "Stop",
        "category": "Earful",
        "icon": "$(debug-stop)"
      },
      {
        "command": "readItToMe.previous",
        "title": "Back One Part",
        "category": "Earful",
        "icon": "$(chevron-left)"
      },
      {
        "command": "readItToMe.next",
        "title": "Forward One Part",
        "category": "Earful",
        "icon": "$(chevron-right)"
      },
      {
        "command": "readItToMe.jumpHere",
        "title": "Read From Here",
        "category": "Earful",
        "icon": "$(target)"
      },
      {
        "command": "readItToMe.speed",
        "title": "Change Speed",
        "category": "Earful",
        "icon": "$(dashboard)"
      }
    ],
    "keybindings": [
      {
        "command": "readItToMe.readSelection",
        "key": "alt+r",
        "when": "editorTextFocus"
      },
      {
        "command": "readItToMe.toggle",
        "key": "alt+p"
      },
      {
        "command": "readItToMe.jumpHere",
        "key": "alt+j",
        "when": "editorTextFocus && readItToMe.reading"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "readItToMe.readFile",
          "when": "!readItToMe.reading",
          "group": "navigation@90"
        },
        {
          "command": "readItToMe.previous",
          "when": "readItToMe.reading",
          "group": "navigation@90"
        },
        {
          "command": "readItToMe.toggle",
          "when": "readItToMe.reading",
          "group": "navigation@91"
        },
        {
          "command": "readItToMe.next",
          "when": "readItToMe.reading",
          "group": "navigation@92"
        },
        {
          "command": "readItToMe.speed",
          "when": "readItToMe.reading",
          "group": "navigation@93"
        },
        {
          "command": "readItToMe.stop",
          "when": "readItToMe.reading",
          "group": "navigation@94"
        }
      ],
      "editor/context": [
        {
          "command": "readItToMe.jumpHere",
          "when": "readItToMe.reading",
          "group": "readItToMe@1"
        },
        {
          "command": "readItToMe.readSelection",
          "when": "editorHasSelection",
          "group": "readItToMe@2"
        },
        {
          "command": "readItToMe.readFile",
          "group": "readItToMe@3"
        }
      ],
      "commandPalette": [
        {
          "command": "readItToMe.readSelection",
          "when": "editorIsOpen"
        },
        {
          "command": "readItToMe.readFile"
        },
        {
          "command": "readItToMe.toggle"
        },
        {
          "command": "readItToMe.stop"
        },
        {
          "command": "readItToMe.previous",
          "when": "readItToMe.reading"
        },
        {
          "command": "readItToMe.next",
          "when": "readItToMe.reading"
        },
        {
          "command": "readItToMe.jumpHere",
          "when": "readItToMe.reading"
        },
        {
          "command": "readItToMe.speed",
          "when": "readItToMe.reading"
        }
      ]
    },
    "configuration": {
      "title": "Earful",
      "properties": {
        "readItToMe.server": {
          "type": "string",
          "default": "http://127.0.0.1:8888",
          "description": "Address of the Earful server."
        },
        "readItToMe.password": {
          "type": "string",
          "default": "",
          "description": "Password, if the server was started with one."
        },
        "readItToMe.voice": {
          "type": "string",
          "default": "af_heart",
          "description": "Voice id, for example af_heart."
        },
        "readItToMe.speed": {
          "type": "number",
          "default": 1,
          "description": "Playback speed."
        },
        "readItToMe.stripCode": {
          "type": "boolean",
          "default": true,
          "description": "Strip comment markers and skip code punctuation when reading source files."
        },
        "readItToMe.showPlayerPanel": {
          "type": "boolean",
          "default": false,
          "description": "Show the audio panel beside the file. It is only needed for the one click that lets the editor make sound."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/*.test.js\""
  }
}
